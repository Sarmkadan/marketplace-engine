{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5000"
      },
      "Https": {
        "Url": "https://localhost:5001"
      }
    }
  },
  "MarketplaceSettings": {
    "MaxListingPrice": 1000000,
    "DefaultCurrency": "USD",
    "CacheDuration": 3600,
    "MaxSearchResults": 1000,
    "DefaultPageSize": 20,
    "MaxPageSize": 100,
    "EnableModeration": true,
    "RequireEmailVerification": false
  },
  "Database": {
    "Type": "InMemory",
    "ConnectionString": ""
  },
  "Marketplace": {
    "PaymentGateway": {
      "ApiKey": "",
      "BaseUrl": "https://api.payments.example.com",
      "TimeoutSeconds": 30,
      "MaxRetries": 3,
      "Currency": "USD"
    },
    "Pricing": {
      "DefaultTaxRate": 0.0,
      "RoundingMode": "AwayFromZero",
      "MaxDiscountPercent": 50,
      "Currency": "USD"
    },
    "Inventory": {
      "LowStockThreshold": 5,
      "ReservationTtlMinutes": 15
    }
  },
  "Features": {
    "SearchEnabled": true,
    "MessagingEnabled": true,
    "ModerationEnabled": true,
    "FeaturedListingsEnabled": true,
    "PremiumSellerFeatures": true
  }
}
