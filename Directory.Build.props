<Project>
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Authors>Vladyslav Zaiets</Authors>
    <Copyright>Copyright (c) 2026 Vladyslav Zaiets</Copyright>
    <!-- NU1510: package pruning suggestions for implicitly-referenced packages in web SDK -->
    <!-- NU1903: known vulnerability in transitive Microsoft.OpenApi 2.0.0 (via Swashbuckle) -->
    <!-- IDE0011: missing braces around single-line statements (pre-existing style) -->
    <!-- IDE0161: file-scoped vs block-scoped namespace (pre-existing mixed style) -->
    <!-- CS8600-CS8604,CS8625: nullable reference warnings in test project -->
    <!-- ASP0004,ASP0005,ASP0016,ASP0019: pre-existing ASP.NET analyzer issues in health check and middleware -->
    <!-- CA2017: logging template parameter count mismatch in ListingsController -->
    <WarningsNotAsErrors>NU1510;NU1903;IDE0011;IDE0161;CS8600;CS8601;CS8604;CS8625;ASP0004;ASP0005;ASP0016;ASP0019;CA2017</WarningsNotAsErrors>
    <PackageProjectUrl>https://github.com/sarmkadan/marketplace-engine</PackageProjectUrl>
  </PropertyGroup>
</Project>
